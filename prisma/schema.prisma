generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  passwordHash        String
  role                UserRole              @default(STUDENT)
  createdAt           DateTime              @default(now())
  collegeAdminProfile CollegeAdminProfile[]

  @@map("users")
}

model College {
  id                String                @id @default(uuid())
  name              String
  slug              String                @unique
  state             String
  city              String
  logoUrl           String?
  coverImageUrl     String?
  brochureUrl       String?
  officialApplyUrl  String
  isPartner         Boolean               @default(false)
  commissionRate    Float                 @default(0.0)
  placementScore    Float
  collegeLifeScore  Float
  curriculumScore   Float
  metadata          String?
  createdAt         DateTime              @default(now())
  website           String?
  admissionPathways AdmissionPathway[]
  adminProfiles     CollegeAdminProfile[]
  branches          CollegeBranch[]
  leads             Lead[]
  recommendations   Recommendation[]
  scholarships      Scholarship[]

  @@map("colleges")
}

model CollegeAdminProfile {
  userId    String
  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, collegeId])
  @@map("college_admin_profiles")
}

model CollegeBranch {
  id                     String  @id @default(uuid())
  collegeId              String
  branchName             String
  branchCode             String
  tuitionFeeAnnual       Float
  hostelFeeAnnual        Float
  seatCapacity           Int
  avgSalary              Float?
  medianSalary           Float?
  highestSalary          Float?
  minJeePercentileCutoff Float?
  minClass12Cutoff       Float?
  branchStrengthScore    Float
  metadata               String?
  placementPercentage    Float?
  college                College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, branchCode])
  @@map("college_branches")
}

model Student {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  phone              String            @unique
  jeePercentile      Float?
  class12Percentage  Float?
  budgetLimit        Float?
  isBudgetConstraint Boolean           @default(true)
  restrictLocation   Boolean           @default(false)
  createdAt          DateTime          @default(now())
  careerGoal         CareerGoal?       @default(NOT_SURE)
  examType           String?
  leads              Lead[]
  recommendations    Recommendation[]
  locations          StudentLocation[]
  priorities         StudentPriority[]

  @@map("students")
}

model StudentLocation {
  studentId String
  state     String
  city      String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, state, city])
  @@map("student_locations")
}

model StudentPriority {
  studentId String
  criteria  String
  rankOrder Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, criteria])
  @@unique([studentId, rankOrder])
  @@map("student_priorities")
}

model Recommendation {
  id           String   @id @default(uuid())
  studentId    String
  collegeId    String
  branchCode   String
  matchScore   Float
  rankPosition Int
  reasons      String
  createdAt    DateTime @default(now())
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("recommendations")
}

model Lead {
  id                    String                 @id @default(uuid())
  studentId             String
  collegeId             String
  branchCode            String
  status                String                 @default("REFERRED")
  trackingToken         String                 @unique
  referredAt            DateTime               @default(now())
  statusUpdatedAt       DateTime               @updatedAt
  commissionTransaction CommissionTransaction?
  college               College                @relation(fields: [collegeId], references: [id])
  student               Student                @relation(fields: [studentId], references: [id])

  @@map("leads")
}

model CommissionTransaction {
  id          String    @id @default(uuid())
  leadId      String    @unique
  amountDue   Float
  status      String    @default("PENDING")
  invoiceDate DateTime?
  paymentDate DateTime?
  createdAt   DateTime  @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id])

  @@map("commission_transactions")
}

model SystemConfig {
  key   String @id
  value String

  @@map("system_configs")
}

model Scholarship {
  id          String   @id @default(uuid())
  collegeId   String
  name        String
  description String?
  amountType  String   @default("FIXED")
  amount      Float
  criteria    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("scholarships")
}

model AdmissionPathway {
  id                      String   @id @default(uuid())
  collegeId               String
  branchCode              String
  admissionExam           String
  equivalentJeePercentile Float?
  admissionMode           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  college                 College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, branchCode, admissionExam])
  @@map("admission_pathways")
}

enum UserRole {
  STUDENT
  ADMIN
  COLLEGE_ADMIN
  SUPERADMIN
}

enum CareerGoal {
  PLACEMENT
  STARTUP
  HIGHER_STUDIES_INDIA
  HIGHER_STUDIES_ABROAD
  GOVERNMENT_EXAMS
  NOT_SURE
}
